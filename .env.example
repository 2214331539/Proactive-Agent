# 复制为 .env 后填写；pa 启动时自动读取（不覆盖已存在的环境变量）。只填你要用的那几个。

# 感知 VLM / 回复 / 慢环 / 判分（OpenAI 兼容）
OPENAI_API_KEY=
# 阿里云 DashScope（Qwen-VL，OpenAI 兼容模式）
DASHSCOPE_API_KEY=
# Google Gemini（OpenAI 兼容端点）
GEMINI_API_KEY=

# 决策：TypeSafe System One（Jev），https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# HuggingFace：国内网络可用镜像
# HF_ENDPOINT=https://hf-mirror.com
# HF_TOKEN=

# 语音播报：豆包语音 seed-audio
DOUBAO_TTS_API_KEY=
